config BR2_PACKAGE_NVIDIA_LEGACY_DRIVER
	bool "NVIDIA GPU driver for Maxwell to Volta (system extension)"
	depends on BR2_x86_64
	depends on BR2_LINUX_KERNEL
	depends on BR2_TOOLCHAIN_BUILDROOT_GLIBC # ldconfig
	select BR2_PACKAGE_HOST_EROFS_UTILS
	help
	  NVIDIA driver 580 with the proprietary kernel modules for
	  GPUs the open kernel modules don't support: Maxwell
	  (GTX 9xx), Pascal (GTX 10xx, Tesla P4/P40/P100) and Volta.
	  It contains the same user space as the "nvidia" extension.

	  Packaged as the system extension image
	  haos_<board>-<version>.nvidia-legacy.raw. Install either
	  this one or the "nvidia" extension, not both.

comment "NVIDIA legacy GPU driver needs the Buildroot glibc toolchain and a Linux kernel"
	depends on BR2_x86_64
	depends on !BR2_LINUX_KERNEL || !BR2_TOOLCHAIN_BUILDROOT_GLIBC
